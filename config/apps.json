    { "name": "Cross Device experience",      "match": "MicrosoftWindows.CrossDevice",        "remove": true },
    { "name": "Widgets web experience",       "match": "MicrosoftWindows.Client.WebExperience","remove": true },
    { "name": "Camera (keep for webcam)",     "match": "Microsoft.WindowsCamera",             "remove": false },
    { "name": "Sound Recorder (keep for mic)","match": "Microsoft.WindowsSoundRecorder",      "remove": false }
  ]
