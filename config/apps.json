    { "name": "Teams (legacy chat)",          "match": "MicrosoftTeams",                      "remove": true },
    { "name": "News",                         "match": "Microsoft.BingNews",                  "remove": true },
    { "name": "Weather",                      "match": "Microsoft.BingWeather",               "remove": true },
    { "name": "Bing Search",                  "match": "Microsoft.BingSearch",                "remove": true },
    { "name": "Get Help",                     "match": "Microsoft.GetHelp",                   "remove": true },
    { "name": "Tips / Get Started",           "match": "Microsoft.Getstarted",                "remove": true },
    { "name": "Solitaire Collection",         "match": "Microsoft.MicrosoftSolitaireCollection","remove": true },
    { "name": "People",                       "match": "Microsoft.People",                    "remove": true },
    { "name": "Power Automate",               "match": "Microsoft.PowerAutomateDesktop",      "remove": true },
    { "name": "Microsoft To Do",              "match": "Microsoft.Todos",                     "remove": true },
    { "name": "Feedback Hub",                 "match": "Microsoft.WindowsFeedbackHub",        "remove": true },
    { "name": "Maps",                         "match": "Microsoft.WindowsMaps",               "remove": true },
    { "name": "Media Player (Groove)",        "match": "Microsoft.ZuneMusic",                 "remove": false },
    { "name": "Movies & TV",                  "match": "Microsoft.ZuneVideo",                 "remove": true },
    { "name": "Phone Link",                   "match": "Microsoft.YourPhone",                 "remove": true },
    { "name": "Family Safety",                "match": "MicrosoftCorporationII.MicrosoftFamily","remove": true },
    { "name": "Quick Assist",                 "match": "MicrosoftCorporationII.QuickAssist", "remove": true },
    { "name": "Dev Home",                     "match": "Microsoft.Windows.DevHome",           "remove": true },
